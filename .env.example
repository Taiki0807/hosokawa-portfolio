# 値はコミットしないこと。ローカルでは .env.local にコピーして使う

# ---- Database ----
# local: ローカル SQLite（.data/dev.sqlite） / d1: Cloudflare D1（HTTP API）
DB_DRIVER=local
# LOCAL_DB_PATH=.data/dev.sqlite
CLOUDFLARE_ACCOUNT_ID=
# 開発では「開発用」の D1 データベース ID を入れる
CLOUDFLARE_D1_DATABASE_ID=
# D1 の編集権限だけを持つ API トークン
CLOUDFLARE_API_TOKEN=
# 本番 D1 の ID（秘密情報ではない）。本番デプロイ以外からこの DB への接続を拒否するために使う
CLOUDFLARE_D1_PRODUCTION_DATABASE_ID=

# ---- R2（画像） ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# カスタムドメイン（例: https://img.hosokawa-lab.dev）
R2_PUBLIC_BASE_URL=

# ---- Mail（Resend） ----
RESEND_API_KEY=
# 認証済みドメインのアドレス（例: Hosokawa Lab <noreply@hosokawa-lab.dev>）
MAIL_FROM=
MAIL_TO=

# ---- Auth（Auth.js + GitHub OAuth） ----
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 管理画面に入れる GitHub ログイン名（カンマ区切り）
ALLOWED_GITHUB_LOGINS=

# ---- AI ----
# openai（既定）| anthropic | mock（mock はローカル・e2e 専用。Vercel 上では無視される）
AI_PROVIDER=openai
OPENAI_API_KEY=
# 使うモデル名（必須。OpenAI のダッシュボードで使えるものを選ぶ）
OPENAI_MODEL=
# 推論モデルのときだけ任意で指定：none | minimal | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=
# AI_PROVIDER=anthropic のとき
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- ホームの AI チャット（自作のローカル LLM）----
# API のベース URL。空ならホームにチャットを出さない。ブラウザには渡さず、/api/chat から中継する
# 変えたら再デプロイする（ホームは静的生成のため）
LOCAL_LLM_BASE_URL=
# 毎回先頭に付ける system（学習データと同じもの）。空なら API の既定値
LOCAL_LLM_SYSTEM_PROMPT=
